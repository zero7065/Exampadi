rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Landing media — public read; any signed-in admin can write.
    // The Admin page itself is gated by isAdmin() (email or VITE_ADMIN_UIDS),
    // so only admins reach this UI. File type + size are still enforced here.
    // Deploy: firebase deploy --only storage
    match /landing/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches("image/.*");
      allow delete: if request.auth != null;
    }
    // Avatars — public read, owner-only write (2MB image cap).
    match /avatars/{uid}/{file} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches("image/.*");
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // AI Tutor uploads — owner-only write/read (50MB, docs+images+video).
    match /uploads/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches("(application/pdf|image/.*|video/.*)");
      allow delete: if request.auth != null;
    }
  }
}
