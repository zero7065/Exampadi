rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == "jadai7065@gmail.com";
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isTeacherOfSchool(schoolId) {
      return request.auth != null
        && userDoc().role == "teacher"
        && userDoc().schoolId == schoolId;
    }

    // Any teacher (used by classroom tools). Doc-independent so list queries
    // (where classId == X) remain provable against the rules.
    function isTeacher() {
      return request.auth != null && userDoc().get("role", "") == "teacher";
    }

    // AI/question counters must only grow — or reset together with their
    // period key (WAT day/month rollover). Blocks counter-tampering that
    // would grant extra AI credits.
    function usageCountersMonotonic() {
      let diff = request.resource.data.diff(resource.data);
      let keys = diff.affectedKeys();
      return (!("aiMessagesDay" in keys)
              || request.resource.data.get("lastAIDay", "") != resource.data.get("lastAIDay", "")
              || request.resource.data.get("aiMessagesDay", 0) >= resource.data.get("aiMessagesDay", 0))
        && (!("aiMessagesMonth" in keys)
              || request.resource.data.get("aiMonth", "") != resource.data.get("aiMonth", "")
              || request.resource.data.get("aiMessagesMonth", 0) >= resource.data.get("aiMessagesMonth", 0))
        && (!("questionsToday" in keys)
              || request.resource.data.get("lastUsageDate", "") != resource.data.get("lastUsageDate", "")
              || request.resource.data.get("questionsToday", 0) >= resource.data.get("questionsToday", 0))
        // Pack credits: client may only spend (down by <= 1 per message), never mint.
        && (!("aiPackCredits" in keys)
              || (request.resource.data.get("aiPackCredits", 0) <= resource.data.get("aiPackCredits", 0)
                  && resource.data.get("aiPackCredits", 0) - request.resource.data.get("aiPackCredits", 0) <= 1));
    }

    // Client subscription writes must be provable: either backed by a
    // verified payment record for that exact reference, or an active
    // Classroom team containing this user (teams.js sets viaTeam).
    // The server (/api/verify-payment, webhook) bypasses these rules entirely.
    function subscriptionWriteOk() {
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      let sub = request.resource.data.get("subscription", {});
      let teamId = sub.get("viaTeam", "");
      let ref = sub.get("reference", "");
      let team = teamId != "" ? get(/databases/$(database)/documents/teams/$(teamId)).data : {};
      let pay = ref != "" ? get(/databases/$(database)/documents/payments/$(ref)).data : {};
      // No subscription change, or only revoking access, is harmless.
      // Activating must be backed by an active Classroom team or a
      // verified payment owned by this user.
      return !("subscription" in keys)
        || sub.get("status", "") != "active"
        || (teamId != ""
            && team.get("status", "") == "active"
            && request.auth.uid in team.get("members", []))
        || (ref != ""
            && pay.get("verified", false) == true
            && pay.get("userId", "") == request.auth.uid);
    }

    // ─── USERS ───
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if (request.auth.uid == userId
                        && request.resource.data.get("role", "user") == "user")
                    || isAdmin();
      // Owners can update their own profile but can never change their role
      // (blocks client-side privilege escalation). Admin can do anything.
      // subscription: written after Paystack verification by our server
      // (/api/verify-payment or the webhook). Client writes only pass when
      // backed by a verified payment or an active Classroom team.
      allow update: if isAdmin()
        || (request.auth.uid == userId
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["role"])
            && usageCountersMonotonic()
            && subscriptionWriteOk());
      allow delete: if isAdmin();
    }

    // ─── USER SUBCOLLECTIONS (sessions, subjectStats) ───
    match /users/{userId}/{document=**} {
      allow read: if request.auth.uid == userId || isAdmin();
      allow write: if request.auth.uid == userId || isAdmin();
    }

    // ─── SESSIONS (top-level) ───
    match /sessions/{sessionId} {
      // Teachers may read sessions of students in their school
      // (roster/heatmap drill-down in TeacherDashboard).
      allow read: if request.auth.uid == resource.data.userId
        || isAdmin()
        || (request.auth != null
            && isTeacherOfSchool(get(/databases/$(database)/documents/users/$(resource.data.userId)).data.schoolId));
      allow create: if request.auth.uid == request.resource.data.userId || isAdmin();
      allow delete: if request.auth.uid == resource.data.userId || isAdmin();
      allow update: if request.auth.uid == resource.data.userId || isAdmin();
    }

    // ─── MOCK EXAMS ───
    match /mockExams/{mockId} {
      allow read: if request.auth.uid == resource.data.userId || isAdmin();
      allow create: if request.auth.uid == request.resource.data.userId || isAdmin();
      allow delete: if request.auth.uid == resource.data.userId || isAdmin();
      allow update: if request.auth.uid == resource.data.userId || isAdmin();
    }

    // ─── NOTES ───
    match /notes/{noteId} {
      allow read: if request.auth.uid == resource.data.userId || isAdmin();
      allow create: if request.auth.uid == request.resource.data.userId || isAdmin();
      allow delete: if request.auth.uid == resource.data.userId || isAdmin();
      allow update: if request.auth.uid == resource.data.userId || isAdmin();
    }

    // ─── ACTIVITY LOG ───
    match /activityLog/{logId} {
      allow read: if request.auth.uid == resource.data.userId || isAdmin();
      allow create: if request.auth != null;
      allow delete: if isAdmin();
    }

    // ─── FEEDBACK ───
    match /feedback/{feedbackId} {
      allow read: if request.auth.uid == resource.data.userId || isAdmin();
      allow create: if request.auth != null;
      allow delete: if isAdmin();
    }

    // ─── STUDY PLANS ───
    match /studyPlans/{userId} {
      allow read: if request.auth.uid == userId || isAdmin();
      allow write: if request.auth.uid == userId || isAdmin();
    }

    // ─── QUESTIONS ───
    match /questions/{questionId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ─── STATS (global) — public counters shown on the landing page ───
    match /stats/{statId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ─── PAYMENTS (server-written evidence; admin reads) ───
    match /payments/{paymentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ─── STUDY PAIRS ───
    match /studyPairs/{pairId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.users ||
        isAdmin()
      );
      allow delete: if request.auth != null && (
        request.auth.uid in resource.data.users ||
        isAdmin()
      );
    }

    // ─── INVITATIONS ───
    match /invitations/{inviteId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == request.resource.data.fromUid;
      allow update: if request.auth != null;
    }

    // ─── SHARED TESTS ───
    match /sharedTests/{testId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == request.resource.data.creatorUid;
      allow update: if request.auth != null;
    }

    // ─── FRIEND DISCUSSIONS (pair members only) ───
    match /discussions/{pairId} {
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.users;
      allow read, update: if request.auth != null && (
        request.auth.uid in resource.data.users || isAdmin()
      );
      allow delete: if isAdmin();
      match /messages/{msgId} {
        allow read: if request.auth != null && (
          request.auth.uid in get(/databases/$(database)/documents/discussions/$(pairId)).data.users
          || isAdmin()
        );
        allow create: if request.auth != null
          && request.auth.uid == request.resource.data.fromUid
          && request.auth.uid in get(/databases/$(database)/documents/discussions/$(pairId)).data.users;
      }
    }

    // ─── HELP BOARD (community assistance) ───
    match /helpRequests/{reqId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.uid || isAdmin()
      );
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.uid || isAdmin()
      );
    }
    match /helpReplies/{replyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid;
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.uid || isAdmin()
      );
    }

    // ─── USER SESSIONS (subcollection via questions.js) ───
    match /userSessions/{userId}/{document=**} {
      allow read: if request.auth.uid == userId || isAdmin();
      allow write: if request.auth.uid == userId || isAdmin();
    }

    // ─── AI MEMORY (per-user tutor memory) ───
    match /aiMemory/{userId} {
      allow read: if request.auth.uid == userId || isAdmin();
      allow write: if request.auth.uid == userId || isAdmin();
    }

    // ─── SITE CONTENT (landing media, public read, admin write) ───
    match /siteContent/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── SCHOOLS ───
    match /schools/{schoolId} {
      // Public can file a request (create with status pending only);
      // reads/writes restricted to members, teachers of the school, admin.
      allow create: if request.auth != null
        && request.resource.data.status == "pending";
      allow read: if request.auth != null && (
        isAdmin()
        || resource.data.contactEmail == request.auth.token.email
        || isTeacherOfSchool(schoolId)
      );
      allow update: if isAdmin();
      // Generated exams archive
      match /exams/{examId} {
        allow read, write: if request.auth != null && (
          isAdmin() || isTeacherOfSchool(schoolId)
        );
      }
    }

    // ─── CLASSES ───
    match /classes/{classId} {
      // Students in the class, its creator, teachers of the school, admin.
      // The schoolId clause makes the teacher list query
      // (where schoolId == X) provable against rules.
      allow read: if request.auth != null && (
        isAdmin()
        || request.auth.uid in resource.data.students
        || (resource.data.keys().hasAny(["createdBy"]) && resource.data.createdBy == request.auth.uid)
        || (resource.data.keys().hasAny(["schoolId"]) && isTeacherOfSchool(resource.data.schoolId))
      );
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.createdBy;
      allow update: if request.auth != null && (
        isAdmin() || resource.data.createdBy == request.auth.uid
      );
    }

    // ─── CLASS INVITES (code lookup by anyone signed in; join is open-code) ───
    match /classInvites/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }

    // ─── CLASSROOM LIVE TOOLS (ClassroomMode + TeacherTools) ───
    // Polls: teacher creates/owns; every signed-in user may read to see it.
    match /classPolls/{pollId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && (isAdmin() || request.resource.data.teacherUid == request.auth.uid);
      allow update, delete: if isAdmin()
        || (request.auth != null && resource.data.teacherUid == request.auth.uid);
    }

    // Poll votes: a student writes ONLY their own single vote doc; the teacher
    // (or admin) reads all votes for a class and derives the tallies. A student
    // can therefore never inflate another option's count.
    match /classPollVotes/{voteId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.studentUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // "I get it / I'm confused" signals + last-active: owner writes own doc,
    // teacher/admin read for the live engagement board.
    match /classResponses/{respId} {
      allow read: if isAdmin() || isTeacher();
      allow create, update: if request.auth != null
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.classId is string;
      allow delete: if isAdmin();
    }

    // "Raise hand" attention requests: student creates own; teacher resolves.
    match /attentionRequests/{reqId} {
      allow read: if isAdmin() || isTeacher();
      allow create: if request.auth != null
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.classId is string
        && request.resource.data.resolved == false;
      allow update, delete: if isAdmin() || isTeacher();
    }

    // Class announcements: teacher writes (own), everyone signed-in reads.
    match /classAnnouncements/{annId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && (isAdmin() || request.resource.data.teacherUid == request.auth.uid);
      allow update, delete: if isAdmin()
        || (request.auth != null && resource.data.teacherUid == request.auth.uid);
    }

    // ─── TEACHER NOTES ───
    match /teacherNotes/{noteId} {
      allow read: if request.auth != null && (
        isAdmin() || isTeacherOfSchool(resource.data.schoolId)
      );
      allow create, update: if request.auth != null && (
        isAdmin() || isTeacherOfSchool(request.resource.data.schoolId)
      );
      allow delete: if isAdmin();
    }

    // ─── TEAMS (group subscriptions) ───
    // Any signed-in user can read a team doc — joining by code runs a query
    // (`where code == X`) that must pass rules BEFORE membership exists.
    // Joins: the joiner adds ONLY themselves via arrayUnion (enforced below).
    match /teams/{teamId} {
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.payerUid
        && request.resource.data.status == "pending";
      allow read: if request.auth != null;
      allow update: if request.auth != null && (
        isAdmin()
        // payer activating their own pending team
        || (request.auth.uid == resource.data.payerUid
            && resource.data.status == "pending"
            && request.resource.data.status == "active")
        // a joiner adding ONLY themselves (seats enforced in app + code secrecy)
        || (request.auth.uid in request.resource.data.members
            && !(request.auth.uid in resource.data.get("members", [])))
      );
      allow delete: if isAdmin();
      // Team thread: members + payer + admin
      match /messages/{msgId} {
        allow read: if request.auth != null && (
          isAdmin()
          || request.auth.uid == get(/databases/$(database)/documents/teams/$(teamId)).data.payerUid
          || request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.get("members", [])
        );
        allow create: if request.auth != null
          && request.auth.uid == request.resource.data.fromUid
          && (
            request.auth.uid == get(/databases/$(database)/documents/teams/$(teamId)).data.payerUid
            || request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.get("members", [])
          );
      }
      // Pinned insights (payer curates, members read)
      match /insights/{insightId} {
        allow read: if request.auth != null && (
          isAdmin()
          || request.auth.uid == get(/databases/$(database)/documents/teams/$(teamId)).data.payerUid
          || request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.get("members", [])
        );
        allow create, update, delete: if request.auth != null && (
          isAdmin()
          || request.auth.uid == get(/databases/$(database)/documents/teams/$(teamId)).data.payerUid
        );
      }
    }

    // ─── STUDY ROOMS (open-by-code: anyone with the code joins instantly) ───
    // Rooms are created "approved" so the host's friends can join right away by
    // sharing the code. The public listing still just filters approved rooms,
    // so admins can remove/close abusive rooms.
    match /studyRooms/{code} {
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.hostUid
        && request.resource.data.status in ["approved", "pending"];
      // host + admin always; others read approved rooms (list queries must
      // filter where status == "approved" to be provable).
      allow read: if request.auth != null && (
        isAdmin()
        || request.auth.uid == resource.data.hostUid
        || resource.data.status == "approved"
      );
      // Progress is server-owned (api/room-answer.js, Admin SDK bypasses
      // rules): the client never grades itself or writes counters. A client
      // may only add its own zeroed progress entry exactly once — joining.
      // Existing members are frozen; status changes are admin-only.
      allow update: if request.auth != null && (
        isAdmin()
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["progress"])
          && !(request.auth.uid in resource.data.get("progress", {}))
          && request.resource.data.progress.keys().hasAll(resource.data.get("progress", {}).keys())
          && request.resource.data.progress.keys().size() == resource.data.get("progress", {}).keys().size() + 1
          && request.resource.data.progress[request.auth.uid].answered == 0
          && request.resource.data.progress[request.auth.uid].correct == 0
          && request.resource.data.progress[request.auth.uid].name
          && request.resource.data.progress[request.auth.uid].total > 0
        )
      );
      allow delete: if isAdmin() || request.auth.uid == resource.data.hostUid;

      // Answer keys: never readable by any client (host can't peek via the
      // console either). Only the host who created the room may seed keys,
      // once each, in the SAME batch that creates the room. Each key doc
      // carries hostUid (unreadable, so no exposure) to make this provable
      // without relying on getAfter(). Grading happens server-side via Admin
      // SDK (bypasses rules).
      match /key/{qid} {
        allow read, list: if false;
        allow create: if request.auth != null
          && request.resource.data.hostUid == request.auth.uid;
        allow update, delete: if false;
      }

      // Graded responses: server-only (dedup + source of truth for verdicts).
      match /responses/{uid} {
        allow read, list, create, update, delete: if false;
      }
    }

    // ─── REVIEWS (admin-moderated: nothing public until admin approves) ───
    match /reviews/{reviewId} {
      // approved reviews readable by any signed-in user; authors see their own;
      // admins see everything (pending queue). Anonymous (landing) uses the
      // canned fallback in the client.
      allow read: if isAdmin()
        || (request.auth != null && (
          resource.data.status == "approved" || request.auth.uid == resource.data.uid
        ));
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid
        && request.resource.data.status == "pending";
      // Liking is open to every signed-in user (likeReview from the Feed).
      // Constraints: only likes/likeCount change; the caller's own uid must
      // be the single membership toggle; likeCount must equal likes.size()
      // so counters cannot be inflated.
      allow update: if request.auth != null && (
        isAdmin()
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["likes", "likeCount"])
          && ((request.auth.uid in request.resource.data.get("likes", [])
                && !(request.auth.uid in resource.data.get("likes", [])))
              || (!(request.auth.uid in request.resource.data.get("likes", []))
                && request.auth.uid in resource.data.get("likes", [])))
          && request.resource.data.get("likes", []).size() == resource.data.get("likes", []).size()
              + ((request.auth.uid in request.resource.data.get("likes", [])) ? 1 : -1)
          && request.resource.data.get("likeCount", 0) == request.resource.data.get("likes", []).size()
        )
      );
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.uid || isAdmin()
      );
    }

    // ─── SURVEYS (one active; admin writes, users vote once) ───
    match /surveys/{surveyId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }
    match /surveyVotes/{voteId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.uid || isAdmin()
      );
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid;
      allow update, delete: if isAdmin();
    }

    // ─── UPDATES / CHANGELOG (admin writes, signed-in reads) ───
    match /updates/{updateId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // ─── PILOT REQUESTS (public form → create only) ───
    match /pilotRequests/{reqId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ─── AI TRAINING DATA (user write, admin read) ───
    match /aiTrainingData/{entryId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isAdmin();
    }

    // ─── TEACHER INVITES ───
    // The random code is the secret (same trust model as classInvites).
    // Any signed-in user may look up codes; redemption may only flip an
    // unused invite to used for themselves.
    match /teacherInvites/{inviteId} {
      allow read: if isAdmin() || request.auth != null;
      allow create: if request.auth != null;
      allow update: if isAdmin()
        || (request.auth != null
            && resource.data.used == false
            && request.resource.data.used == true
            && request.resource.data.usedBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["used", "usedBy", "usedAt"]));
      allow delete: if isAdmin();
    }

    // ─── PARTNER COMMISSIONS (server-written; school contact/teacher + admin read) ───
    match /commissions/{commissionId} {
      allow read: if isAdmin() || (request.auth != null && (
        get(/databases/$(database)/documents/schools/$(resource.data.schoolId)).data.get("contactEmail", "") == request.auth.token.email
        || isTeacherOfSchool(resource.data.schoolId)
      ));
      allow create: if false; // server-only (verify-payment + webhook via Admin SDK)
      // Admin may settle payouts (status pending → paid).
      allow update: if isAdmin();
    }

    // ─── AI USAGE LOG (cost monitoring; client creates its own rows) ───
    match /aiUsageLog/{entryId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // ─── AI SESSIONS (owner read/write) ───
    match /aiSessions/{sessionId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // ─── TEACHER ASSIGNMENTS (teacher write, assigned students read) ───
    match /teacherAssignments/{assignmentId} {
      allow read: if request.auth != null && (resource.data.teacherId == request.auth.uid || request.auth.uid in resource.data.studentIds);
      allow create, update, delete: if request.auth != null && request.auth.uid == resource.data.teacherId;
    }

    // ─── TEACHER ANNOUNCEMENTS (school-scoped) ───
    match /teacherAnnouncements/{announcementId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == resource.data.teacherId;
    }
  }
}
