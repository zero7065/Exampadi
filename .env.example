# ============================================
# ExamPadi — Environment Configuration
# ============================================
# Copy this to .env and fill with your actual keys

# ========== FIREBASE (Required for Auth & Database) ==========
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=

# Web Push certificate public key (Firebase Console -> Project settings ->
# Cloud Messaging -> Web configuration -> Web Push certificates).
# Required only for browser push notifications; the in-app bell works without it.
VITE_FIREBASE_VAPID_KEY=

# ========== AI TUTOR (server-side via api/ai.js) ==========
# Deliberately NOT VITE_GROQ_API_KEY: Vite inlines any VITE_-prefixed var into
# the public JS bundle, which would publish the key to every visitor.
# Set GROQ_API_KEY (non-prefixed) in BOTH:
#   1. this .env            (local / `vercel dev`)
#   2. Vercel → Project Settings → Environment Variables  (production)
GROQ_API_KEY=your_groq_api_key_here
# OpenAI API (server-side fallback)
OPENAI_API_KEY=

# Firebase Admin service account JSON, pasted as ONE line.
# Firebase Console -> Project settings -> Service accounts -> Generate new private key.
# Required for /api/ai, /api/image, /api/notify, /api/reminders, and server grading.
FIREBASE_SERVICE_ACCOUNT=

# Image generation (server-side; optional)
GEMINI_API_KEY=
HF_API_KEY=

# ========== PAYMENTS (Required for Pro subscriptions) ==========
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Sandbox key starts with pk_test_
# Live key starts with pk_live_

# ========== MONITORING & ANALYTICS (Optional) ==========
# Error tracking with Sentry
VITE_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@xxxxx.ingest.us.sentry.io/xxxxx

# Analytics tracking (Google Analytics 4)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ========== APP CONFIGURATION ==========
VITE_APP_URL=http://localhost:5173

# Comma-separated admin Firebase UIDs (extra admins besides the owner email)
VITE_ADMIN_UIDS=

# Admin auto-seed (local dev only — creates the owner account on first run)
VITE_SEED_ADMIN_EMAIL=
VITE_SEED_ADMIN_PASSWORD=

# ========== E2E / SCREENSHOTS (local dev only, never commit values) ==========
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# ========== INTERNAL: Do NOT share or commit ==========
# Server-only. Never prefix this with VITE_.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx